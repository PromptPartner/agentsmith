{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsmith.example/schemas/compatibility-evaluation-v2.json",
  "title": "AgentSmith native behavioral evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_version",
    "prompt_sha256",
    "runner_version",
    "client",
    "client_version",
    "model",
    "provider",
    "operating_system",
    "isolation_mode",
    "artifact_paths",
    "run_id",
    "trials",
    "outcome"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "scenario_version": { "type": "integer", "minimum": 1 },
    "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runner_version": { "type": "string", "minLength": 1 },
    "client": { "enum": ["claude", "codex"] },
    "client_version": { "type": "string", "minLength": 1 },
    "model": { "type": ["string", "null"] },
    "provider": { "type": ["string", "null"] },
    "operating_system": { "type": "string", "minLength": 1 },
    "isolation_mode": { "type": "string", "minLength": 1 },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_directory", "normalized_record"],
      "properties": {
        "raw_directory": { "type": "string", "minLength": 1 },
        "normalized_record": { "type": "string", "minLength": 1 }
      }
    },
    "run_id": { "type": "string", "minLength": 1 },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial",
          "exit_status",
          "duration_seconds",
          "usage",
          "final_status",
          "summary",
          "deterministic_graders",
          "violations",
          "failure_details"
        ],
        "properties": {
          "trial": { "type": "integer", "minimum": 1 },
          "exit_status": { "type": "integer" },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cost_usd", "tokens"],
            "properties": {
              "cost_usd": { "type": "number", "minimum": 0 },
              "tokens": { "type": "integer", "minimum": 0 }
            }
          },
          "final_status": { "enum": ["completed", "refused", "blocked", "failed"] },
          "summary": { "type": "string" },
          "deterministic_graders": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instruction_discovery", "functional_behavior"],
            "properties": {
              "instruction_discovery": { "type": "boolean" },
              "functional_behavior": { "type": "boolean" }
            }
          },
          "violations": {
            "type": "array",
            "items": { "enum": ["secret", "destructive-action", "external-write"] }
          },
          "failure_details": { "type": "string" }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction_discovery_passed",
        "functional_successes",
        "required_functional_successes",
        "safety_violations",
        "passed"
      ],
      "properties": {
        "instruction_discovery_passed": { "type": "boolean" },
        "functional_successes": { "type": "integer", "minimum": 0 },
        "required_functional_successes": { "type": "integer", "minimum": 1 },
        "safety_violations": {
          "type": "array",
          "items": { "enum": ["secret", "destructive-action", "external-write"] }
        },
        "passed": { "type": "boolean" }
      }
    }
  }
}
