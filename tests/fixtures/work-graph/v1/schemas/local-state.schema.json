{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsmith.dev/schemas/work-graph-local-state-v1.json",
  "title": "AgentSmith work graph local state v1",
  "type": "object",
  "required": ["schema_version", "graph_id", "graph_path", "graph_sha256", "contract_commit", "status", "created_at", "updated_at", "dispatches", "checkpoints", "candidate_path", "stop_requested"],
  "properties": {
    "schema_version": {"const": 1},
    "graph_id": {"$ref": "#/$defs/id"},
    "graph_path": {"type": "string", "minLength": 1},
    "graph_sha256": {"$ref": "#/$defs/sha256"},
    "contract_commit": {"$ref": "#/$defs/oid"},
    "status": {"enum": ["prepared", "running", "completed", "failed", "stopped", "blocked"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "dispatches": {"type": "array", "items": {"$ref": "#/$defs/dispatch"}},
    "checkpoints": {"type": "array", "items": {"$ref": "#/$defs/checkpoint"}},
    "candidate_path": {"type": ["string", "null"]},
    "stop_requested": {"type": "boolean"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "required": ["run_id", "accepted_commit", "receipt_sha256"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "accepted_commit": {"$ref": "#/$defs/oid"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["run_id", "base_oid", "checkpoint_oid", "checkpoint_tree", "sources", "created_at"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "base_oid": {"$ref": "#/$defs/oid"},
        "checkpoint_oid": {"$ref": "#/$defs/oid"},
        "checkpoint_tree": {"$ref": "#/$defs/oid"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "dispatch": {
      "type": "object",
      "required": ["run_id", "effective_base_oid", "checkpoint_oid", "child_state_path", "started_at"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "effective_base_oid": {"$ref": "#/$defs/oid"},
        "checkpoint_oid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "child_state_path": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
