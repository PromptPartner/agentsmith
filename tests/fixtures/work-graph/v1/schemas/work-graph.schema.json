{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsmith.dev/schemas/work-graph-v1.json",
  "title": "AgentSmith work graph v1",
  "type": "object",
  "required": ["schema_version", "graph_id", "max_parallel", "integration_order", "nodes"],
  "properties": {
    "schema_version": {"const": 1},
    "graph_id": {"$ref": "#/$defs/id"},
    "max_parallel": {"type": "integer", "minimum": 1, "maximum": 2},
    "integration_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node": {
      "type": "object",
      "required": ["run_id", "manifest_path", "manifest_sha256", "depends_on"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "manifest_path": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\][^\\\\]*$"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
