{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsmith.dev/schemas/work-graph-integration-candidate-v1.json",
  "title": "AgentSmith local integration candidate v1",
  "type": "object",
  "required": ["schema_version", "graph_id", "graph_sha256", "contract_commit", "base_oid", "candidate_branch", "candidate_commit", "candidate_tree", "sources", "verification", "created_at", "external_write_used", "human_approval_required"],
  "properties": {
    "schema_version": {"const": 1},
    "graph_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_commit": {"$ref": "#/$defs/oid"},
    "base_oid": {"$ref": "#/$defs/oid"},
    "candidate_branch": {"type": "string", "pattern": "^agentsmith-graph/[A-Za-z0-9_-]+/candidate/[0-9]{3}$"},
    "candidate_commit": {"$ref": "#/$defs/oid"},
    "candidate_tree": {"$ref": "#/$defs/oid"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "verification": {
      "type": "object",
      "required": ["command", "exit_code", "receipt_sha256"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"const": 0},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"},
    "external_write_used": {"const": false},
    "human_approval_required": {"const": true}
  },
  "$defs": {
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source": {
      "type": "object",
      "required": ["run_id", "accepted_commit", "receipt_sha256", "already_included"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "accepted_commit": {"$ref": "#/$defs/oid"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "already_included": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
