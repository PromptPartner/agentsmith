{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsmith.dev/schemas/work-graph-status-v1.json",
  "title": "AgentSmith work graph status v1",
  "type": "object",
  "required": ["schema_version", "graph_id", "graph_sha256", "contract_commit", "status", "ready_set", "nodes", "next_action"],
  "properties": {
    "schema_version": {"const": 1},
    "graph_id": {"$ref": "#/$defs/id"},
    "graph_sha256": {"$ref": "#/$defs/sha256"},
    "contract_commit": {"$ref": "#/$defs/oid"},
    "status": {"enum": ["prepared", "running", "completed", "failed", "stopped", "blocked"]},
    "ready_set": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "next_action": {"$ref": "#/$defs/action"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "action": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": {"command": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["run_id", "status", "reason", "effective_base_oid", "next_action"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["ready", "waiting", "conflicting", "running", "completed", "failed", "blocked", "interrupted"]},
        "reason": {"type": "string", "minLength": 1},
        "effective_base_oid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "accepted_commit": {"$ref": "#/$defs/oid"},
        "next_action": {"$ref": "#/$defs/action"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
