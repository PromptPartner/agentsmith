{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsmith.dev/schemas/verification-plan-v1.json",
  "title": "AgentSmith verification discovery plan v1",
  "type": "object",
  "required": ["schema_version", "target", "generated_at", "input_fingerprint", "detected_stacks", "evidence", "existing_phases", "proposed_phases", "coverage", "unresolved", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "target": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {
      "type": "object",
      "required": ["algorithm", "value", "files"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "detected_stacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "root", "evidence_paths"],
        "properties": {
          "name": {"enum": ["python", "node", "go", "rust", "shell", "documentation"]},
          "root": {"type": "string", "minLength": 1},
          "evidence_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "detail"],
        "properties": {
          "kind": {"enum": ["manifest", "source", "test", "configuration", "ci-hint", "task-runner-hint"]},
          "path": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "existing_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "command", "categories", "origin"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "categories": {"type": "array", "items": {"$ref": "#/$defs/category"}, "uniqueItems": true},
          "origin": {"enum": ["user", "agentsmith-placeholder", "agentsmith"]}
        },
        "additionalProperties": false
      }
    },
    "proposed_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "label", "command", "detector", "source_path", "reason", "confidence_class", "requires_review"],
        "properties": {
          "category": {"$ref": "#/$defs/category"},
          "label": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "detector": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "confidence_class": {"enum": ["high", "medium", "low"]},
          "requires_review": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "coverage": {"$ref": "#/$defs/coverage"},
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "paths"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "category": {"enum": ["build", "type_check", "lint_static_analysis", "unit_integration_tests", "dependency_risk", "secret_scan", "real_path_exercise", "judgment_evaluation"]},
    "coverageCell": {
      "type": "object",
      "required": ["state", "evidence", "gap"],
      "properties": {
        "state": {"enum": ["configured", "recommended", "manual", "missing", "not-applicable"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "gap": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["build", "type_check", "lint_static_analysis", "unit_integration_tests", "dependency_risk", "secret_scan", "real_path_exercise", "judgment_evaluation"],
      "properties": {
        "build": {"$ref": "#/$defs/coverageCell"},
        "type_check": {"$ref": "#/$defs/coverageCell"},
        "lint_static_analysis": {"$ref": "#/$defs/coverageCell"},
        "unit_integration_tests": {"$ref": "#/$defs/coverageCell"},
        "dependency_risk": {"$ref": "#/$defs/coverageCell"},
        "secret_scan": {"$ref": "#/$defs/coverageCell"},
        "real_path_exercise": {"$ref": "#/$defs/coverageCell"},
        "judgment_evaluation": {"$ref": "#/$defs/coverageCell"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
