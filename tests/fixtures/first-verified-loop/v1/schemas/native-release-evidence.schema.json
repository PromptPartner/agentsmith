{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsmith.dev/schemas/native-release-evidence-v1.json",
  "title": "AgentSmith native First Verified Loop release evidence v1",
  "type": "object",
  "required": ["schema_version", "evidence_kind", "status", "platform", "git_commit", "git_tree", "dirty_before", "dirty_after", "python_version", "recorded_at", "phases", "security_coverage", "network_used", "external_write_used"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_kind": {"const": "agentsmith-first-verified-loop-native-platform"},
    "status": {"enum": ["passed", "failed"]},
    "platform": {"enum": ["linux", "macos", "windows"]},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirty_before": {"type": "boolean"},
    "dirty_after": {"type": "boolean"},
    "python_version": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "command", "exit_code", "stdout_sha256", "stderr_sha256"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "exit_code": {"type": "integer"},
          "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "security_coverage": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"enum": ["command-injection", "path-traversal", "symlink-escape", "plan-tampering", "secret-redaction", "foreign-file-preservation", "git-state-safety"]}
    },
    "network_used": {"const": false},
    "external_write_used": {"const": false}
  },
  "additionalProperties": false
}
