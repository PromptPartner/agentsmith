{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsmith.dev/schemas/profile-recommendation-v1.json",
  "title": "AgentSmith profile recommendation v1",
  "type": "object",
  "required": ["schema_version", "target", "signals", "recommendations", "ambiguous", "next_action"],
  "properties": {
    "schema_version": {"const": 1},
    "target": {"type": "string", "minLength": 1},
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "source_path", "detail"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rank", "profile", "reason", "tradeoffs", "coverage_gaps"],
        "properties": {
          "rank": {"type": "integer"},
          "profile": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "tradeoffs": {"type": "array", "items": {"type": "string"}},
          "coverage_gaps": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "ambiguous": {"type": "boolean"},
    "next_action": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
