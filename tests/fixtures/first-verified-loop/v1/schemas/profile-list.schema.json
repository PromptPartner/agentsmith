{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsmith.dev/schemas/profile-list-v1.json",
  "title": "AgentSmith profile list v1",
  "type": "object",
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "purpose", "work_types", "verification_preset"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "work_types": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "verification_preset": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
