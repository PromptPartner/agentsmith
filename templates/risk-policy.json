{
  "schema_version": 1,
  "attention_limit": 5,
  "rules": [
    {"paths": ["docs/**", "**/*.md"], "tier": "A"},
    {"paths": ["tests/**", "**/test_*.py", "**/*_test.go", "**/*.test.*"], "tier": "A"},
    {"paths": ["src/**"], "tier": "B"},
    {"paths": ["**/locales/**", "**/i18n/**"], "tier": "B", "lenses": ["locales"]},
    {"paths": ["src/auth/**", "src/**/permissions/**"], "tier": "C", "lenses": ["security"]},
    {"paths": ["**/package.json", "**/package-lock.json", "**/pnpm-lock.yaml", "**/yarn.lock",
               "**/requirements*.txt", "**/pyproject.toml", "**/poetry.lock", "**/uv.lock",
               "**/Pipfile", "**/Pipfile.lock", "**/go.mod", "**/go.sum", "**/Cargo.toml", "**/Cargo.lock",
               "**/Gemfile", "**/Gemfile.lock"], "tier": "C", "lenses": ["dependencies"]}
  ]
}
